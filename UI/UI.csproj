<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>UI</RootNamespace>
    <AssemblyName>UI</AssemblyName>
    <!-- Injection goes through EasyHook64.dll and the hook is a 64-bit native DLL. -->
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DotNetProjects.Extended.Wpf.Toolkit" Version="5.0.129" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <!-- Only for build order and restore, the hook is published by the PublishHook target below. -->
    <ProjectReference Include="..\Hook\Hook.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="EasyHook32.dll;EasyHook32Svc.exe;EasyHook64.dll;EasyHook64Svc.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Publish the hook with Native AOT next to UI.exe, so it can be injected into the target.
    Native AOT needs the Windows C++ build tools, so this is skipped on other operating systems.
  -->
  <Target Name="PublishHook" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <MSBuild Projects="..\Hook\Hook.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(TargetDir)" />
  </Target>

</Project>
